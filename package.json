{
  "name": "paper-desk",
  "version": "0.0.1",
  "private": true,
  "description": "Reads one arXiv paper a night into a verified record and a short video script (eve Builder Challenge entry).",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "test": "node --import tsx --test 'test/**/*.test.ts'",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "eval:root": "eve eval",
    "eval:bench": "cd harness/bench && eve eval",
    "eval:gate": "cd harness/github-gate && eve eval"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@types/node": "24.19.4",
    "@vercel/connect": "2.9.6",
    "ai": "7.0.183",
    "cheerio": "1.2.0",
    "eve": "1.5.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "vercel": "^67.0.0"
  }
}
